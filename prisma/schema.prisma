generator client {
  provider = "prisma-client.js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  // Relazione virtuale(no crea colonna in MySQL)
  products  Product[]
}

model Product {
  id Int @id @default(autoincrement())
}

